<section class="thh-best" data-row aria-labelledby="BestTitle-{{ section.id }}">
  <div class="page-width">
    <div class="thh-best__head">
      <h2 class="thh-best__title" id="BestTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      <hr class="thh-best__hr">
    </div>
    <div class="thh-best__wrap">
      <button type="button" class="thh-best__arrow thh-best__arrow--prev" data-row-prev aria-label="Previous products">{% render 'thh-icon', icon: 'prev' %}</button>
      <ul class="thh-best__track" data-row-strip aria-label="{{ section.settings.title | escape }}">
        {%- if section.settings.products != blank -%}
          {%- for product in section.settings.products -%}{% render 'thh-best-item', product: product %}{%- endfor -%}
        {%- else -%}
          {%- for product in section.settings.collection.products limit: 12 -%}{% render 'thh-best-item', product: product %}{%- endfor -%}
        {%- endif -%}
      </ul>
      <button type="button" class="thh-best__arrow thh-best__arrow--next" data-row-next aria-label="Next products">{% render 'thh-icon', icon: 'next' %}</button>
    </div>
    {%- if section.settings.more_label != blank -%}<div class="thh-best__more"><a href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">{{ section.settings.more_label | escape }}</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "THH best sellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Best Sellers" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used when no products are picked." },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "Show more" },
    { "type": "url", "id": "more_link", "label": "Link" }
  ],
  "presets": [{ "name": "THH best sellers" }]
}
{% endschema %}
