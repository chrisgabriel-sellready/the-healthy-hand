<section class="faq-section" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="page-width faq-section__inner">
    <h2 class="kb-heading faq-section__heading" id="FaqTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- for block in section.blocks -%}{% render 'thh-accordion', block: block %}{%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "THH FAQ band",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "info": "[email] becomes the customer care email." },
      { "type": "text", "id": "anchor", "label": "Anchor ID (optional)", "info": "e.g. shipping, so links to #shipping open here." },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] }
  ],
  "presets": [{ "name": "THH FAQ band" }]
}
{% endschema %}
