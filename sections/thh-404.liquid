<div class="page-width main-page">
  <div class="page-narrow" style="text-align:center">
    <h1 class="kb-heading main-page__title">{{ section.settings.title | escape }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    <p style="margin-top:20px"><a class="kb-btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a></p>
  </div>
</div>

{% schema %}
{
  "name": "THH page not found",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Page not found" },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you were looking for doesn't exist." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop all products" }
  ]
}
{% endschema %}
