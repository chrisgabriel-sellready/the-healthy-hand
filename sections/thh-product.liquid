{%- comment -%}
  Product page from the mock-up. Optional product metafields:
  custom.subtitle (text), custom.free_from (list of text), custom.collage_products (list of products: bundle contents).
  Accordion blocks can read a metafield (e.g. custom.ingredients) and fall back to their own text.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign sale = false
  if variant.compare_at_price > variant.price
    assign sale = true
  endif
  capture rating
    render 'thh-product-rating', product: product, field: 'rating'
  endcapture
  capture count
    render 'thh-product-rating', product: product, field: 'count'
  endcapture
  assign rating = rating | strip | plus: 0
  assign includes = product.metafields.custom.collage_products.value
  assign free_from = product.metafields.custom.free_from.value
  assign desc_lower = product.description | downcase
  assign email = settings.thh_email | default: 'thehealthyhands@gmail.com'
  assign product_form_id = 'ProductForm-' | append: section.id
-%}
<div class="page-width">
  <nav class="breadcrumb" aria-label="Breadcrumb" style="margin-top:24px"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a> / <span aria-current="page">{{ product.title | escape }}</span></nav>
  {%- form 'product', product, id: product_form_id, class: 'thh-product-form' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
    {%- capture payment_terms -%}{{ form | payment_terms }}{%- endcapture -%}
  {%- endform -%}
  <section class="product" data-product>
    <div class="product__media">
      <div class="product__media-main" data-product-main>
        {%- if includes != blank and product.images.size < 2 -%}
          <div class="card__collage" role="img" aria-label="{{ product.title | escape }}: {{ includes | map: 'title' | join: ', ' | escape }}">{%- for p in includes limit: 4 -%}{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 500 }}" alt="">{% endif %}{%- endfor -%}</div>
        {%- elsif product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}{% if product.images.size > 1 %}, image 1 of {{ product.images.size }}{% endif %}" width="1100" height="1100">
        {%- endif -%}
      </div>
      <ul class="product__thumbs" aria-label="Product images"{% if product.images.size < 2 %} hidden{% endif %}>
        {%- for image in product.images -%}
          <li><button type="button" class="product__thumb" data-src="{{ image | image_url: width: 1100 }}" data-alt="{{ product.title | escape }}, image {{ forloop.index }} of {{ product.images.size }}" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ image | image_url: width: 200 }}" alt=""></button></li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="product__info">
      <p class="product__vendor">{{ product.vendor | escape }}</p>
      <h1 class="product__title">{{ product.title | escape }}</h1>
      {%- if product.metafields.custom.subtitle != blank -%}<p class="product__sub">{{ product.metafields.custom.subtitle | escape }}</p>{%- endif -%}
      <div class="product__rating">
        {%- if rating > 0 -%}{% render 'thh-stars', rating: rating %}<a href="#reviews">{{ rating | round: 1 }} from {{ count | strip }} reviews</a>
        {%- else -%}<span class="product__sub" style="margin:0">No reviews yet</span>{%- endif -%}
      </div>
      <div class="product__price" data-product-price>
        <span class="price-item--sale{% if sale %} price--sale{% endif %}">{{ variant.price | money }}</span>
        {%- if sale -%}<s><span class="visually-hidden">Regular price</span>{{ variant.compare_at_price | money }}</s><span class="badge">Save {{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}%</span>{%- endif -%}
        {%- if product.metafields.custom.badge != blank -%}<span class="badge badge--promo">{{ product.metafields.custom.badge | escape }}</span>{%- endif -%}
      </div>
      <p class="product__installments">{{ payment_terms }}</p>
      {%- if free_from != blank -%}
        <ul class="product-features" aria-label="Free from">{%- for f in free_from limit: 6 -%}<li>{% render 'thh-icon', icon: 'check' %}{{ f | escape }}</li>{%- endfor -%}</ul>
      {%- endif -%}
      {%- if includes != blank -%}
        <div class="product__includes"><b>What&rsquo;s included</b><ul>{%- for p in includes -%}<li><a href="{{ p.url }}">{{ p.title | escape }}</a></li>{%- endfor -%}</ul></div>
      {%- endif -%}
      <div class="product-form">
        {%- unless product.has_only_default_variant -%}
          <label class="product-form__label" for="Variant-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
          <select id="Variant-{{ section.id }}" class="product-form__variant" data-variant-select>
            {%- for v in product.variants -%}<option value="{{ v.id }}" data-price="{{ v.price | money }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}" data-available="{{ v.available }}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }}{% unless v.available %} (sold out){% endunless %}</option>{%- endfor -%}
          </select>
        {%- endunless -%}
        <span class="product-form__label" id="QtyLabel-{{ section.id }}">Quantity</span>
        <div class="qty" role="group" aria-labelledby="QtyLabel-{{ section.id }}">
          <button type="button" data-step="-1" aria-label="Decrease quantity" disabled>&minus;</button>
          <input type="number" name="quantity" form="{{ product_form_id }}" min="1" max="20" value="1" aria-label="Quantity">
          <button type="button" data-step="1" aria-label="Increase quantity">+</button>
        </div>
        <div class="product-form__buttons">
          <button type="submit" form="{{ product_form_id }}" class="product-form__submit" data-add="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add to cart &middot; {{ variant.price | money }}{% else %}Sold out{% endif %}</button>
        </div>
      </div>
      {%- if section.settings.ship_note != blank -%}<p class="product__ship-note">{% render 'thh-icon', icon: 'truck' %}<span>{{ section.settings.ship_note | escape }}</span></p>{%- endif -%}
      <div class="product__description">{{ product.description }}</div>
      <div class="product__accordions">
        {%- for block in section.blocks -%}
          {%- liquid
            assign body = ''
            if block.settings.metafield != blank
              assign parts = block.settings.metafield | split: '.'
              assign mf = product.metafields[parts[0]][parts[1]]
              if mf != blank
                if mf.type == 'list.single_line_text_field'
                  capture body
                    echo '<ul>'
                    for item in mf.value
                      echo '<li>' | append: item | append: '</li>'
                    endfor
                    echo '</ul>'
                  endcapture
                elsif mf.type == 'rich_text_field'
                  assign body = mf | metafield_tag
                else
                  assign body = mf.value | newline_to_br | prepend: '<p>' | append: '</p>'
                endif
              endif
            endif
            if body == blank
              assign body = block.settings.content | replace: '[email]', email
            endif
            assign show_senna = false
            if block.settings.senna_note and desc_lower contains 'senna'
              assign show_senna = true
            endif
          -%}
          {%- if body != blank or show_senna -%}
          <details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}{% render 'thh-icon', icon: 'plus' %}</summary><div class="accordion__content">
            {%- if show_senna -%}<p class="notice">{{ section.settings.senna_text | escape }}</p>{%- endif -%}
            {%- if show_senna and body != blank -%}<div style="margin-top:12px">{{ body }}</div>{%- else -%}{{ body }}{%- endif -%}
          </div></details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.fda != blank -%}<p class="fda">{{ section.settings.fda | escape }}</p>{%- endif -%}
    </div>
  </section>
</div>
<script type="application/json" data-product-json>{{ product | json }}</script>

{% schema %}
{
  "name": "THH product",
  "settings": [
    { "type": "text", "id": "ship_note", "label": "Shipping note", "default": "Free shipping on orders $100+. Ships by USPS in 7–10 business days; a signature is needed on delivery." },
    { "type": "textarea", "id": "senna_text", "label": "Senna notice", "default": "Contains senna leaf, a natural stimulant laxative. Stay near a restroom, drink plenty of water, and talk to your doctor before use if you are pregnant, nursing, taking medication or have a medical condition.", "info": "Shown in accordions with \"Show senna notice\" when the product description mentions senna." },
    { "type": "textarea", "id": "fda", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease. Read the label and use as directed. Talk to your doctor before use if you are pregnant, nursing, taking medication or have a medical condition." }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "metafield", "label": "Product metafield (optional)", "info": "namespace.key, e.g. custom.ingredients. Its value is used when the product has one." },
        { "type": "richtext", "id": "content", "label": "Text", "info": "[email] becomes the customer care email." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "checkbox", "id": "senna_note", "label": "Show senna notice", "default": false }
      ]
    }
  ]
}
{% endschema %}
