<section class="hero" data-slideshow aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign p = block.settings.product
      assign alt = block.settings.image.alt | default: block.settings.alt
      capture rating
        if p != blank
          render 'thh-product-rating', product: p, field: 'rating'
        endif
      endcapture
      capture count
        if p != blank
          render 'thh-product-rating', product: p, field: 'count'
        endif
      endcapture
      assign rating = rating | strip | plus: 0
    -%}
    <div class="slideshow__slide slideshow__slide--{{ block.settings.style }}{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ alt | escape }}" {{ block.shopify_attributes }}>
      <div class="hero__image-wrapper">
        {%- if block.settings.image != blank -%}
          <img class="hero__image" src="{{ block.settings.image | image_url: width: 1400 }}" srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1400 }} 1400w, {{ block.settings.image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ alt | escape }}" width="1400" height="{{ 1400 | divided_by: block.settings.image.aspect_ratio | round }}"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
        {%- elsif p.featured_image -%}
          <img class="hero__image" src="{{ p.featured_image | image_url: width: 1400 }}" alt="{{ alt | default: p.title | escape }}" width="1400" height="1400"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
        {%- endif -%}
      </div>
      <div class="hero__text-wrap"><div class="page-width"><div class="hero__text-content">
        {%- if block.settings.kicker != blank -%}<p class="hero__top-subtitle">{{ block.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="hero__title">{{ block.settings.title | escape }} <strong>{{ block.settings.title_bold | escape }}</strong></h2>
        <div class="hero__subtitle">{{ block.settings.text }}{% if rating > 0 %}<p>{% render 'thh-stars', rating: rating %} {{ rating | round: 1 }} from {{ count | strip }} verified reviews</p>{% endif %}</div>
        {%- if block.settings.button != blank -%}<div class="hero__link"><a class="kb-btn" href="{{ block.settings.link | default: p.url }}">{{ block.settings.button | escape }}</a></div>{%- endif -%}
      </div></div></div>
    </div>
  {%- endfor -%}

  <div class="slideshow__controls">
    {%- for block in section.blocks -%}<button type="button" class="slideshow__dot" aria-label="Slide {{ forloop.index }}"><span></span></button>{%- endfor -%}
    <button type="button" class="slideshow__pause" aria-label="Pause slideshow"><span data-state="pause">{% render 'thh-icon', icon: 'pause' %}</span><span data-state="play">{% render 'thh-icon', icon: 'play' %}</span></button>
  </div>
</section>

{% schema %}
{
  "name": "THH slideshow",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Featured products" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "style", "label": "Background style", "default": "tea", "options": [{ "value": "tea", "label": "Warm orange" }, { "value": "kit", "label": "Lime (dark button)" }, { "value": "system", "label": "Cream" }] },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the product's main image." },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "product", "id": "product", "label": "Product", "info": "Used for the star rating and as the default link." },
        { "type": "text", "id": "kicker", "label": "Small text above the title" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "title_bold", "label": "Title, bold part" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "THH slideshow", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
