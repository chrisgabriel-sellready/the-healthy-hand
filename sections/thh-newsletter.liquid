{%- comment -%}
  Sign-up band above the footer.
  Default "email": THH's live mailing list look ("Join our Mailing List and stay updated", email field,
  lime Sign Up button). It uses Shopify's newsletter form, so subscribers are saved as customers with
  email marketing consent, and Klaviyo's Shopify integration syncs them.
  "via" / "klaviyo": the mock-up's HealthyText phone sign-up, sent to THH's VIA keyword or a Klaviyo SMS list.
{%- endcomment -%}
{%- if section.settings.enabled -%}
{%- if section.settings.provider == 'email' -%}
<section class="newsletter newsletter--mailing" aria-labelledby="MailingTitle">
  <div class="page-width">
    <h2 class="newsletter__mailing-title" id="MailingTitle">{{ section.settings.email_heading | escape }} <span>{{ section.settings.email_heading_end | escape }}</span></h2>
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail">Email</label>
      <input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" required>
      <button class="kb-btn newsletter__signup" type="submit">{{ section.settings.email_button | escape }}</button>
      {%- if form.posted_successfully? -%}<p class="form-status" role="status">{{ section.settings.success_email | escape }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="form-status" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{%- else -%}
<section class="newsletter" aria-labelledby="HealthyText">
  <div class="page-width">
    <h2 class="newsletter__heading" id="HealthyText">{{ section.settings.heading | escape }}</h2>
    <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- if section.settings.embed != blank -%}
      {{ section.settings.embed }}
    {%- else -%}
      <form class="newsletter-form" data-sms-signup data-provider="{{ section.settings.provider }}" data-via-keyword="{{ section.settings.via_keyword | escape }}" data-company="{{ section.settings.klaviyo_company | escape }}" data-list="{{ section.settings.klaviyo_list | escape }}" data-done="{{ section.settings.success | escape }}">
        <label class="visually-hidden" for="NewsletterPhone">Phone number</label>
        <input id="NewsletterPhone" type="tel" name="phone" autocomplete="tel" placeholder="Phone number" required>
        <button class="kb-btn kb-btn--ink" type="submit">Subscribe</button>
      </form>
    {%- endif -%}
    <p class="newsletter__fine">{{ section.settings.fine }}</p>
  </div>
</section>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "THH sign-up band",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show", "default": true },
    { "type": "select", "id": "provider", "label": "Sign-up type", "default": "email", "options": [{ "value": "email", "label": "Mailing list (email, THH's current style)" }, { "value": "via", "label": "HealthyText by text (VIA)" }, { "value": "klaviyo", "label": "HealthyText by text (Klaviyo SMS list)" }] },
    { "type": "header", "content": "Mailing list" },
    { "type": "text", "id": "email_heading", "label": "Heading", "default": "Join our Mailing List and" },
    { "type": "text", "id": "email_heading_end", "label": "Heading, last part", "default": "stay updated" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your@email.com" },
    { "type": "text", "id": "email_button", "label": "Button", "default": "Sign Up" },
    { "type": "text", "id": "success_email", "label": "Success message", "default": "Thanks for signing up!" },
    { "type": "header", "content": "HealthyText (text messages)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HealthyText" },
    { "type": "text", "id": "text", "label": "Text", "default": "Put in your phone number below to subscribe!" },
    { "type": "text", "id": "via_keyword", "label": "VIA keyword ID", "default": "6123f00bd49731000806fd85", "info": "From the HealthyText subscribe page template." },
    { "type": "text", "id": "klaviyo_company", "label": "Klaviyo public API key (company ID)", "default": "SUJAkf" },
    { "type": "text", "id": "klaviyo_list", "label": "Klaviyo SMS list ID", "info": "Only for Klaviyo. Klaviyo → Lists & segments → your SMS list → Settings → List ID." },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks for subscribing! Check your phone for a text from us." },
    { "type": "html", "id": "embed", "label": "Form embed code (optional)", "info": "Paste another provider's SMS form here to use it instead of the built-in form." },
    { "type": "textarea", "id": "fine", "label": "Small print", "default": "By subscribing you agree to receive recurring automated marketing texts. Consent is not a condition of purchase. Msg & data rates may apply. Reply STOP to unsubscribe." }
  ]
}
{% endschema %}
